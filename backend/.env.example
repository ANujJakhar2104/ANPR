# Copy this file to .env and fill in real values. Never commit .env.

# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite by default. Swap for Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/anpr
DATABASE_URL=sqlite:///./data/anpr.db

# Where uploaded files and generated results are stored on disk
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs

# Your existing model weights
COCO_MODEL_PATH=./models/yolov8n.pt
PLATE_MODEL_PATH=./models/license_plate_detector.pt

# EasyOCR on GPU or CPU
OCR_USE_GPU=false

# CORS - the origin(s) your frontend runs on
FRONTEND_ORIGIN=http://localhost:3000
